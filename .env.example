# Gốc REST API (không có dấu / ở cuối)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Thời gian chờ mỗi request (ms)
EXPO_PUBLIC_API_TIMEOUT=20000
# Dùng mock API ngay trong app, không cần backend (true | false). Xem README mục "Mock API".
EXPO_PUBLIC_API_MOCK=true
# FCM cho bản native tích hợp (tùy chọn). Tên gói phải khớp ứng dụng đã đăng ký trong Firebase.
# Profile integration tự bật MAYDAY_FCM_ENABLED. Khi build local, đường dẫn file Firebase bật FCM cho nền tảng tương ứng.
# MAYDAY_GOOGLE_SERVICES_JSON=./google-services.json
# MAYDAY_GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
# MAYDAY_ANDROID_PACKAGE=vn.drmayday.app
# MAYDAY_IOS_BUNDLE_ID=vn.drmayday.app
# MAYDAY_APS_ENVIRONMENT=production
